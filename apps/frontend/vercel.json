  "buildCommand": "pnpm build",
  "outputDirectory": ".next",
  "installCommand": "npm install -g pnpm@12.6.0 && pnpm install --frozen-lockfile",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://agc-backend-ix19.onrender.com/api/:path*"
    }
  ]
}