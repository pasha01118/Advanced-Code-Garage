# Supabase Configuration
SUPABASE_URL=https://sdmvjjvvzbwnccwaeomh.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx          # or SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Security
SECRET_KEY=your-super-secret-jwt-key-change-me
USER_KEY_ENCRYPTION_KEY=""                           # Fernet key; defaults to SECRET_KEY when unset
APP_BOOTSTRAP_TOKEN=""                               # required for first-run admin sign-up
ADMIN_RESET_TOKEN=""                                 # unlocks admin "forgot password" reset
ADMIN_USER_IDS=""                                    # comma-separated JWT sub allowlist (legacy admins)
TRUSTED_PROXY_CIDRS=""                               # Render proxy IPs/CIDRs allowed to set X-Forwarded-For
CRON_SECRET=""                                       # bearer token for /api/cron/sentinel (Vercel Cron)

# GitHub App + repository secrets vault
GITHUB_APP_ID=""                                     # numeric App ID
GITHUB_APP_SLUG=""                                   # App URL slug (informational)
GITHUB_APP_PRIVATE_KEY=""                            # PEM private key; \n escapes are accepted
GITHUB_APP_WEBHOOK_SECRET=""                         # used to verify X-Hub-Signature-256
GITHUB_API_BASE_URL=https://api.github.com           # change for GitHub Enterprise
VAULT_KEK_VERSION=v1                                 # current vault key version
VAULT_PREVIOUS_KEKS=""                               # "v1:<old-secret>,v2:<older-secret>" for rotation

# Sentinel
SENTINEL_INTERVAL_SECONDS=60

# AI Providers (BYOK)
GOOGLE_AI_STUDIO_KEY=
GOOGLE_AI_STUDIO_PROXY=
GOOGLE_AI_STUDIO_PROXY_TOKEN=
OLLAMA_BASE_URL=http://localhost:11434

# App Config
ENVIRONMENT=development
FRONTEND_URLS=http://localhost:3000
